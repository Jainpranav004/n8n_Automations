    {
      "parameters": {
        "jsCode": "let revenue = 0;\nlet expenses = 0;\nlet pendingPayments = 0;\n\nconst departmentTotals = {};\nconst categoryTotals = {};\n\nfor (const item of items) {\n\n  const type = item.json[\"Type (Revenue/Expense)\"]?.trim().toLowerCase();\n\n  const amount = Number(item.json[\"Amount\"]) || 0;\n\n  const status = item.json[\"Status\"];\n\n  const department = item.json[\"Department\"];\n\n  const category = item.json[\"Category\"];\n\n  // Revenue vs Expense\n  if (type === \"revenue\") {\n    revenue += amount;\n  } else {\n    expenses += amount;\n  }\n\n  // Pending Payments\n  if (status === \"Pending\") {\n    pendingPayments += amount;\n  }\n\n  // Department Totals\n  if (!departmentTotals[department]) {\n    departmentTotals[department] = 0;\n  }\n\n  departmentTotals[department] += amount;\n\n  // Category Totals\n  if (!categoryTotals[category]) {\n    categoryTotals[category] = 0;\n  }\n\n  categoryTotals[category] += amount;\n}\n\nconst profit = revenue - expenses;\n\nreturn [\n  {\n    json: {\n      revenue,\n      expenses,\n      profit,\n      pendingPayments,\n      departmentTotals,\n      categoryTotals\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        64,
